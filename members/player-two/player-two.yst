        {
          "id": "6b2c105c9e0b48af8e8e880f74326220",
          "kind": "text",
          "x": 22,
          "y": 302,
          "w": 596,
          "h": 65,
          "text": "A game interrupted by the bell goes on the slip in pencil. We finish it next Friday. Neither player gets to \"remember\" a win.",
          "src": "",
          "href": "",
          "color": "#252333",
          "fill": "",
          "font_family": "Verdana",
          "font_size": 17,
